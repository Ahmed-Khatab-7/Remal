# Normalise line endings so the repo is identical on Windows, macOS and Linux.
* text=auto eol=lf

*.sln       text eol=crlf
*.csproj    text eol=crlf
*.props     text eol=crlf
*.ps1       text eol=crlf

*.png       binary
*.jpg       binary
*.jpeg      binary
*.webp      binary
*.ico       binary
*.woff      binary
*.woff2     binary

# Keep third-party vendored code out of language stats.
backend/src/Remal.Api/wwwroot/signalr.min.js  linguist-vendored
